// Cloudflare settings for keystagelearning.org.
// `npm run build` turns this into dist/client/wrangler.json, and `npm run deploy` uploads that.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keystagelearning",
  "compatibility_date": "2026-11-17",
  // The site answers on www.keystagelearning.org. The bare .org address and both .net
  // addresses are sent here by Cloudflare redirect rules (set up in the dashboard).
  "routes": [{ "pattern": "www.keystagelearning.org", "custom_domain": true }],
  // Accounts and sign-in. Cloudflare creates the database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "keystagelearning" }],
  // Sign-in emails go through Resend; its key is the RESEND_API_KEY secret,
  // added in the dashboard (Settings → Variables and Secrets), never in this file.
  // Stripe price ids (not secret). These are the TEST (sandbox) prices; swap for the live ones at launch.
  // The secret key and webhook secret are Cloudflare Secrets: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET.
  "vars": {
    "STRIPE_PRICE_MONTHLY": "price_1UedkAFxeUeyrBdVEU1eNJJI",
    "STRIPE_PRICE_YEARLY": "price_1UedqmFxeUeyrBdV520G46kL"
  },
  "observability": { "enabled": true }
}
