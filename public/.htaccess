# Key Stage Learning: rules for Hostinger (Apache)
ErrorDocument 404 /404.html
Options -Indexes

RewriteEngine On
# Always use HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# keystagelearning.net and the bare .org go to https://www.keystagelearning.org
RewriteCond %{HTTP_HOST} ^(www\.)?keystagelearning\.net$ [NC,OR]
RewriteCond %{HTTP_HOST} ^keystagelearning\.org$ [NC]
RewriteRule ^ https://www.keystagelearning.org%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|png|jpg|svg|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
