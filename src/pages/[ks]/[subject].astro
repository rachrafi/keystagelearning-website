---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import VideoCard from '../../components/VideoCard.astro';
import { keyStages, subjects, topicsFor, videosInTopic, type KeyStage } from '../../data/catalogue';

export function getStaticPaths() {
  return keyStages.filter((k) => k.live).flatMap((k) =>
    subjects.filter((s) => s.live).map((s) => ({ params: { ks: k.id, subject: s.id } })));
}
const ksId = Astro.params.ks as KeyStage;
const ks = keyStages.find((k) => k.id === ksId)!;
const subject = subjects.find((s) => s.id === Astro.params.subject)!;
const list = topicsFor(subject.id, ksId);
---
<Base title={`${ks.name} ${subject.name}`} description={`Free ${ks.name} ${subject.name} video lessons and quizzes.`} active={ksId}>
  <div class:list={['page-hero', ksId]}>
    <div class="wrap">
      <Crumbs items={[{ label: ks.name, href: `/${ksId}/` }, { label: subject.name }]} />
      <h1>{ks.name} {subject.name}</h1>
      <p>Every {ks.name} lesson, topic by topic. Watch the lesson, then try the quiz if there is one.</p>
    </div>
  </div>
  {list.map((t, i) => (
    <section id={t.id} class:list={['tight', { white: i % 2 === 0 }]}>
      <div class="wrap">
        <h2>{t.title}</h2>
        <p class="intro" style="margin-bottom:20px">{t.blurb} <a href={`/${subject.id}/${t.id}/`}>See the whole topic</a></p>
        <div class="video-grid">
          {videosInTopic(t.id).filter((v) => v.keyStages.includes(ksId)).map((v) => <VideoCard video={v} />)}
        </div>
      </div>
    </section>
  ))}
</Base>
