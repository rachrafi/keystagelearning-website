---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="page-hero">
    <div class="wrap" style="display:flex;gap:24px;align-items:center;flex-wrap:wrap">
      <img src="/images/pengbot.png" alt="" width="120" />
      <div>
        <h1>Oops! Pengbot can't find that page</h1>
        <p>It may have moved. Try one of these instead.</p>
      </div>
    </div>
  </div>
  <section>
    <div class="wrap cta-row">
      <a class="btn btn-navy" href="/">Home</a>
      <a class="btn btn-navy" href="/ks2/">KS2</a>
      <a class="btn btn-navy" href="/ks3/">KS3</a>
      <a class="btn btn-yellow" href="/search/">Search</a>
    </div>
  </section>
</Base>
